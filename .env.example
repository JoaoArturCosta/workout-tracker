# Database
DATABASE_URL="postgresql://user:password@host:5432/workout_tracker"
TEST_DATABASE_URL="postgresql://user:password@host:5432/workout_tracker_test"

# Authentication
NEXTAUTH_SECRET="replace-with-a-long-random-value"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# Supabase
SUPABASE_URL="https://project.supabase.co"
SUPABASE_ANON_KEY="replace-with-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"

# Rest-finished alerts
# Keep one stable VAPID key pair across deploys. The public key is the only key
# exposed to browser code.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace-with-stable-public-vapid-key"
VAPID_PRIVATE_KEY="replace-with-stable-private-vapid-key"
VAPID_SUBJECT="mailto:alerts@example.com"

# QStash signs delayed callbacks with the current or next key during rotation.
QSTASH_TOKEN="replace-with-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="replace-with-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="replace-with-next-signing-key"

# Canonical HTTPS origin used both to publish and verify QStash callbacks.
APP_URL="https://workouts.example.com"

NODE_ENV="development"
